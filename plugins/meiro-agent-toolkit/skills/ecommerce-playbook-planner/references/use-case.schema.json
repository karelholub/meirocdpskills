{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karelholub/meirocdpskills/ecommerce-use-case.schema.json",
  "title": "Meiro ecommerce use case",
  "type": "object",
  "required": [
    "id", "name", "tier", "kpis", "channels", "requiredEvents",
    "requiredEventFields", "requiredAttributes", "requiredAssets",
    "requiredPolicies", "defaultJourney", "activationBlockers"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "tier": {"type": "string", "minLength": 1},
    "businessObjective": {"type": "string"},
    "kpis": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "channels": {"type": "array", "items": {"type": "string"}},
    "requiredEvents": {"type": "array", "items": {"type": "string"}},
    "requiredEventFields": {"type": "array", "items": {"type": "string"}},
    "requiredIdentifiers": {"type": "array", "items": {"type": "string"}},
    "requiredAttributes": {"type": "array", "items": {"type": "string"}},
    "requiredAssets": {"type": "array", "items": {"type": "string"}},
    "requiredPolicies": {"type": "array", "items": {"type": "string"}},
    "defaultJourney": {"type": "array", "items": {"type": "string"}},
    "qaScenarios": {"type": "array", "items": {"type": "string"}},
    "stopConditions": {"type": "array", "items": {"type": "string"}},
    "activationBlockers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
