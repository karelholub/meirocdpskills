{
  "id": "meiro-bfsi",
  "version": "1.0.0",
  "industry": "bfsi",
  "status": "governed_draft_playbook",
  "principles": [
    "The CDP supports governed communications and handoffs, not unapproved regulated decisions.",
    "Service, security, contractual and marketing purposes remain distinct.",
    "Sensitive, special-category, vulnerability, fraud, claim, balance, transaction and portfolio data are minimized and purpose-bound.",
    "Eligibility, credit, underwriting, pricing, suitability, portfolio, fraud and claims decisions stay in approved systems with required human oversight."
  ],
  "playbooks": [
    {
      "id": "bfsi-01-application-assistance", "name": "Application or onboarding assistance", "industry": "bfsi", "tier": "application_identity",
      "businessObjective": "Help an applicant resume or complete an initiated process without changing eligibility, pricing or approval outcomes.",
      "kpis": ["application_completion_rate", "time_to_completion", "support_contact_rate"], "channels": ["email", "sms", "web_banner"],
      "requiredEvents": ["application_started", "application_step_completed", "application_submitted", "application_withdrawn", "application_expired"],
      "requiredEventFields": ["application_id", "product_family", "current_step", "next_required_action", "expires_at", "locale"],
      "requiredIdentifiers": ["application_id", "verified_contact", "profile_id"],
      "requiredAttributes": ["application_status", "next_required_action", "application_expiry", "communication_purpose"],
      "requiredAssets": ["secure_resume_link", "approved_process_help", "support_route"],
      "requiredPolicies": ["no_eligibility_inference", "secure_link_expiry", "service_marketing_separation", "data_minimization", "human_support_route"],
      "defaultJourney": ["application_incomplete", "wait_policy_window", "status_recheck", "service_reminder", "optional_support_handoff", "stop_on_submit_or_withdrawal"],
      "measurement": ["process-level holdout where lawful", "completed submissions", "support deflection", "complaint rate"],
      "stopConditions": ["application submitted", "application withdrawn", "application expired", "manual review hold", "contact invalid"],
      "activationBlockers": ["missing_authoritative_application_status", "insecure_resume_link", "unclear_communication_purpose", "unapproved_content"]
    },
    {
      "id": "bfsi-02-kyc-document-reminder", "name": "KYC or document completion reminder", "industry": "bfsi", "tier": "compliance_service",
      "businessObjective": "Remind a customer about an authoritative outstanding compliance action without exposing document or risk details in marketing systems.",
      "kpis": ["required_action_completion", "time_to_completion", "manual_contact_rate"], "channels": ["secure_inbox", "email", "sms", "push"],
      "requiredEvents": ["required_action_created", "document_received", "required_action_completed", "required_action_expired"],
      "requiredEventFields": ["action_reference", "generic_action_type", "due_at", "status", "secure_destination"],
      "requiredIdentifiers": ["customer_id", "verified_contact"],
      "requiredAttributes": ["outstanding_action_flag", "action_due_at", "verified_channel"],
      "requiredAssets": ["secure_action_link", "approved_generic_template", "support_route"],
      "requiredPolicies": ["minimum_necessary_detail", "no_document_content_in_cdp", "service_purpose", "secure_channel_preference", "record_retention"],
      "defaultJourney": ["action_created", "due_window", "status_recheck", "generic_reminder", "escalate_to_approved_service_queue", "stop_on_completion"],
      "measurement": ["completion within SLA", "manual follow-up reduction", "misdelivery rate"],
      "stopConditions": ["action completed", "action expired", "manual hold", "identity mismatch", "secure source unavailable"],
      "activationBlockers": ["missing_authoritative_action_status", "raw_document_data_requested", "unverified_contact", "unapproved_template"]
    },
    {
      "id": "bfsi-03-digital-service-adoption", "name": "Digital self-service adoption", "industry": "bfsi", "tier": "service_engagement",
      "businessObjective": "Educate eligible existing customers about approved self-service capabilities without inferring financial vulnerability or product suitability.",
      "kpis": ["feature_activation", "digital_task_completion", "assisted_service_reduction"], "channels": ["in_app", "web_banner", "email", "push"],
      "requiredEvents": ["authenticated_session", "feature_viewed", "feature_activated", "digital_task_completed"],
      "requiredEventFields": ["feature_id", "interaction_context", "completion_status", "locale"],
      "requiredIdentifiers": ["customer_id", "authenticated_session_id"],
      "requiredAttributes": ["feature_adoption_state", "digital_engagement_level", "communication_preference"],
      "requiredAssets": ["approved_education_content", "secure_feature_link", "accessibility_variant"],
      "requiredPolicies": ["eligible_customer_source", "no_vulnerability_inference", "accessibility", "frequency_cap", "service_marketing_classification"],
      "defaultJourney": ["eligible_customer", "education_message", "feature_activation_split", "single_help_nudge", "stop_on_activation"],
      "measurement": ["customer-level holdout", "incremental activation", "task completion", "support impact"],
      "stopConditions": ["feature activated", "customer in assisted-care suppression", "complaint", "communication preference changed"],
      "activationBlockers": ["unapproved_eligibility_source", "unclear_purpose", "missing_accessible_content", "unverified_secure_link"]
    },
    {
      "id": "bfsi-04-renewal-maturity-service", "name": "Policy renewal or product maturity service", "industry": "bfsi", "tier": "contract_service",
      "businessObjective": "Provide timely, accurate contractual reminders and approved next steps without generating pricing, underwriting or investment advice in the CDP.",
      "kpis": ["on_time_notification", "renewal_or_instruction_completion", "service_contact_rate"], "channels": ["secure_inbox", "email", "sms", "push"],
      "requiredEvents": ["renewal_window_opened", "maturity_window_opened", "customer_instruction_received", "contract_renewed", "contract_closed"],
      "requiredEventFields": ["contract_reference", "product_family", "effective_or_maturity_date", "status", "approved_option_reference"],
      "requiredIdentifiers": ["contract_reference", "customer_id", "verified_contact"],
      "requiredAttributes": ["next_contract_action_date", "contract_status", "approved_service_route"],
      "requiredAssets": ["approved_notice", "secure_contract_link", "advisor_or_service_handoff"],
      "requiredPolicies": ["authoritative_contract_source", "no_pricing_or_advice_generation", "notice_timing", "recordkeeping", "service_marketing_separation"],
      "defaultJourney": ["window_opened", "send_required_notice", "status_recheck", "optional_service_reminder", "handoff_if_needed", "stop_on_instruction"],
      "measurement": ["timely-delivery rate", "completed instruction", "complaint and correction rate"],
      "stopConditions": ["instruction received", "contract renewed_or_closed", "legal hold", "authoritative data conflict"],
      "activationBlockers": ["missing_authoritative_contract_state", "unapproved_notice", "pricing_or_advice_logic_in_cdp", "unverified_contact"]
    },
    {
      "id": "bfsi-05-claims-status-service", "name": "Insurance claim status communication", "industry": "bfsi", "tier": "claim_service_sensitive",
      "businessObjective": "Communicate approved claim-status changes and required actions without using claim or health details for marketing or automated claim decisions.",
      "kpis": ["status_delivery_latency", "required_action_completion", "inbound_status_contacts"], "channels": ["secure_inbox", "sms", "email", "push"],
      "requiredEvents": ["claim_opened", "claim_status_changed", "claim_action_required", "claim_closed"],
      "requiredEventFields": ["claim_reference", "generic_status_code", "required_action_reference", "updated_at", "secure_destination"],
      "requiredIdentifiers": ["claim_reference", "verified_claimant_contact"],
      "requiredAttributes": ["claim_status_category", "claim_action_due", "verified_channel"],
      "requiredAssets": ["approved_status_templates", "secure_claim_link", "human_claims_contact"],
      "requiredPolicies": ["no_health_or_claim_detail_in_marketing", "no_claim_decision_in_cdp", "minimum_necessary_detail", "secure_channel", "human_review_route"],
      "defaultJourney": ["status_changed", "send_generic_update", "required_action_split", "secure_reminder", "stop_on_close"],
      "measurement": ["delivery latency", "action completion", "misdelivery and complaint rate", "contact deflection"],
      "stopConditions": ["claim closed", "identity mismatch", "legal hold", "manual claims stop", "authoritative source unavailable"],
      "activationBlockers": ["raw_claim_or_health_detail_required", "missing_authoritative_status", "unverified_claimant_contact", "unapproved_template"]
    },
    {
      "id": "bfsi-06-educational-next-best-action", "name": "Educational next-best-action and human handoff", "industry": "bfsi", "tier": "marketing_policy_human_review",
      "businessObjective": "Prioritize approved educational content or a human-advisor handoff without determining eligibility, suitability, pricing or advice.",
      "kpis": ["content_engagement", "qualified_handoff", "appointment_completion", "complaint_rate"], "channels": ["web_banner", "in_app", "email", "advisor_queue"],
      "requiredEvents": ["content_viewed", "topic_interest_declared", "appointment_requested", "advisor_handoff_completed"],
      "requiredEventFields": ["content_id", "declared_topic", "channel", "locale", "handoff_reference"],
      "requiredIdentifiers": ["profile_id", "authenticated_customer_id_when_required"],
      "requiredAttributes": ["declared_interests", "content_engagement", "marketing_consent", "advisor_service_status"],
      "requiredAssets": ["compliance_approved_content", "product_governance_mapping", "advisor_handoff_route", "generic_fallback"],
      "requiredPolicies": ["no_eligibility_or_suitability_inference", "declared_not_inferred_interest", "human_review", "marketing_consent", "fairness_review", "recordkeeping"],
      "defaultJourney": ["declared_interest_or_content_engagement", "policy_filter", "educational_content", "optional_human_handoff", "stop_on_request_or_suppression"],
      "measurement": ["randomized content holdout", "qualified handoff", "advisor-reviewed outcome", "fairness and complaint monitoring"],
      "stopConditions": ["consent withdrawn", "customer requests no contact", "vulnerability suppression", "complaint", "human review unavailable"],
      "activationBlockers": ["decision_logic_implies_eligibility_or_suitability", "unapproved_content", "missing_human_handoff", "unverified_consent_or_fairness_review"]
    },
    {
      "id": "bfsi-07-wealth-engagement-handoff", "name": "Wealth content engagement and advisor handoff", "industry": "bfsi", "tier": "wealth_marketing_suitability_boundary",
      "businessObjective": "Support educational engagement and advisor contact while keeping suitability, risk profiling and portfolio advice in approved processes.",
      "kpis": ["educational_engagement", "advisor_meeting_rate", "qualified_service_request"], "channels": ["email", "in_app", "web_banner", "advisor_queue"],
      "requiredEvents": ["research_content_viewed", "webinar_registered", "advisor_contact_requested", "advisor_meeting_completed"],
      "requiredEventFields": ["content_topic", "declared_interest", "locale", "request_reference"],
      "requiredIdentifiers": ["profile_id", "customer_id_for_secure_handoff"],
      "requiredAttributes": ["declared_content_interests", "engagement_recency", "marketing_consent", "advisor_relationship_status"],
      "requiredAssets": ["approved_educational_content", "risk_disclosures", "secure_advisor_handoff"],
      "requiredPolicies": ["no_portfolio_or_balance_data_in_marketing", "no_suitability_or_advice_generation", "declared_interest_only", "marketing_consent", "advisor_review", "recordkeeping"],
      "defaultJourney": ["declared_interest", "approved_education", "engagement_split", "optional_advisor_invitation", "secure_handoff"],
      "measurement": ["content holdout", "advisor meeting completion", "customer feedback", "compliance exceptions"],
      "stopConditions": ["consent withdrawn", "advice requested outside approved channel", "complaint", "advisor relationship suppression"],
      "activationBlockers": ["portfolio_or_balance_targeting", "suitability_logic_in_cdp", "unapproved_disclosures", "missing_advisor_review"]
    },
    {
      "id": "bfsi-08-preference-and-suppression", "name": "Communication preference and suppression orchestration", "industry": "bfsi", "tier": "consent_governance_foundation",
      "businessObjective": "Apply authoritative purpose- and channel-specific preferences, withdrawals and suppressions consistently across customer communications.",
      "kpis": ["suppression_propagation_latency", "preference_accuracy", "unauthorized_contact_rate"], "channels": ["email", "sms", "push", "phone", "paid_audience", "direct_mail"],
      "requiredEvents": ["preference_changed", "consent_withdrawn", "contact_restricted", "suppression_applied"],
      "requiredEventFields": ["customer_id", "purpose", "channel", "status", "effective_at", "source_system", "policy_version"],
      "requiredIdentifiers": ["customer_id", "channel_identifier_reference"],
      "requiredAttributes": ["purpose_channel_permission", "global_suppression", "service_contact_rule", "preference_updated_at"],
      "requiredAssets": ["authoritative_preference_source", "channel_mapping", "suppression_destinations", "audit_log"],
      "requiredPolicies": ["purpose_limitation", "withdrawal_sla", "service_marketing_separation", "source_precedence", "data_retention", "auditability"],
      "defaultJourney": ["preference_change", "validate_source_and_version", "update_permission_state", "propagate_suppression", "verify_destinations", "audit"],
      "measurement": ["propagation SLA", "destination reconciliation", "unauthorized contact incidents", "audit completeness"],
      "stopConditions": ["source conflict", "identity mismatch", "destination failure", "policy version unknown"],
      "activationBlockers": ["no_authoritative_preference_source", "unclear_source_precedence", "unverified_destination_mapping", "missing_audit_log"]
    }
  ]
}
