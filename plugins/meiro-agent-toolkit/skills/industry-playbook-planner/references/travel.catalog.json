{
  "id": "meiro-travel",
  "version": "1.0.0",
  "industry": "travel",
  "status": "governed_draft_playbook",
  "principles": [
    "A playbook is a conditional recipe, not proof that prerequisites exist.",
    "Availability, price, itinerary and disruption data must be current at decision and send time.",
    "Service communications and marketing must use separate purpose, policy and suppression rules.",
    "Passport, health, accessibility, precise-location and minor data are minimized and excluded from marketing profiles unless explicitly approved for a necessary purpose."
  ],
  "playbooks": [
    {
      "id": "travel-01-search-abandonment", "name": "Destination search and browse recovery", "industry": "travel", "tier": "behavioral_inventory",
      "businessObjective": "Help a recent visitor continue a high-intent destination or package search without implying availability or price certainty.",
      "kpis": ["search_to_detail_rate", "qualified_return_rate", "booking_conversion"], "channels": ["web_banner", "email", "push"],
      "requiredEvents": ["travel_search", "offer_viewed", "booking_started", "booking_confirmed"],
      "requiredEventFields": ["destination_id", "departure_market", "departure_window", "party_size", "offer_id", "price", "currency", "availability_timestamp"],
      "requiredIdentifiers": ["anonymous_browser_id", "consented_profile_id_for_direct_channels"],
      "requiredAttributes": ["recent_destination_interest", "recent_departure_window", "booking_status", "channel_consent"],
      "requiredAssets": ["current_offer_feed", "destination_content", "generic_fallback"],
      "requiredPolicies": ["price_and_availability_freshness", "booking_suppression", "frequency_cap", "channel_consent", "cross_device_identity_review"],
      "defaultJourney": ["search_or_offer_view", "wait_2h", "suppress_if_booking_started_or_confirmed", "show_current_matching_offers", "stop_on_booking"],
      "measurement": ["session holdout", "incremental return to booking flow", "confirmed-booking conversion"],
      "stopConditions": ["offer unavailable", "price stale", "booking started", "booking confirmed", "consent withdrawn"],
      "activationBlockers": ["unverified_search_schema", "missing_current_offer_feed", "unverified_booking_suppression", "unverified_consent"]
    },
    {
      "id": "travel-02-booking-abandonment", "name": "Incomplete booking recovery", "industry": "travel", "tier": "booking_identity_inventory",
      "businessObjective": "Help a customer resume an incomplete booking while preventing duplicate reservations and stale-price promises.",
      "kpis": ["booking_completion_rate", "recovered_bookings", "contact_center_deflection"], "channels": ["email", "sms", "web_banner"],
      "requiredEvents": ["booking_started", "traveler_details_started", "payment_started", "booking_confirmed", "booking_expired"],
      "requiredEventFields": ["booking_session_id", "offer_id", "booking_stage", "quoted_price", "currency", "quote_expiry", "party_size"],
      "requiredIdentifiers": ["booking_session_id", "consented_email_or_phone", "profile_id"],
      "requiredAttributes": ["last_incomplete_booking_stage", "quote_expiry", "booking_status", "channel_consent"],
      "requiredAssets": ["secure_resume_link", "current_offer_lookup", "support_contact_fallback"],
      "requiredPolicies": ["secure_link_expiry", "price_revalidation", "confirmed_booking_suppression", "payment_data_exclusion", "channel_consent"],
      "defaultJourney": ["booking_incomplete", "wait_30m", "revalidate_offer", "send_secure_resume", "wait_20h", "stop_or_support_reminder"],
      "measurement": ["randomized holdout", "completed confirmed bookings", "duplicate-booking rate", "complaint rate"],
      "stopConditions": ["booking confirmed", "quote expired", "offer unavailable", "payment dispute", "consent withdrawn"],
      "activationBlockers": ["missing_booking_state_events", "insecure_resume_link", "missing_price_revalidation", "unverified_identity_or_consent"]
    },
    {
      "id": "travel-03-price-availability-alert", "name": "Price or availability alert", "industry": "travel", "tier": "inventory_consent",
      "businessObjective": "Notify an opted-in customer when a watched route, hotel, destination or package meets an explicit condition.",
      "kpis": ["alert_opt_in_rate", "qualified_click_rate", "confirmed_booking_rate"], "channels": ["email", "push", "sms"],
      "requiredEvents": ["alert_created", "offer_price_changed", "availability_changed", "alert_sent", "booking_confirmed"],
      "requiredEventFields": ["alert_id", "offer_or_query_id", "threshold", "current_price", "currency", "availability_timestamp"],
      "requiredIdentifiers": ["profile_id", "verified_channel_identifier"],
      "requiredAttributes": ["active_alerts", "channel_consent", "booking_status"],
      "requiredAssets": ["current_offer_feed", "alert_preference_center", "terms_copy"],
      "requiredPolicies": ["explicit_alert_opt_in", "freshness_sla", "alert_expiry", "frequency_cap", "booking_suppression"],
      "defaultJourney": ["condition_met", "freshness_check", "send_alert", "stop_on_booking_or_expiry"],
      "measurement": ["alert cohort conversion", "unsubscribe rate", "price mismatch rate"],
      "stopConditions": ["alert expired", "offer unavailable", "booking confirmed", "consent withdrawn"],
      "activationBlockers": ["missing_alert_preference", "stale_inventory_feed", "unverified_channel", "missing_terms"]
    },
    {
      "id": "travel-04-predeparture-service", "name": "Pre-departure service journey", "industry": "travel", "tier": "booking_service",
      "businessObjective": "Provide timely operational preparation for a confirmed trip and route customers to authoritative service information.",
      "kpis": ["self_service_completion", "support_contact_rate", "required_action_completion"], "channels": ["email", "sms", "push"],
      "requiredEvents": ["booking_confirmed", "payment_completed", "travel_document_ready", "required_action_completed", "booking_cancelled"],
      "requiredEventFields": ["booking_id", "departure_at", "origin", "destination", "supplier", "required_action_code", "locale"],
      "requiredIdentifiers": ["booking_id", "verified_customer_contact"],
      "requiredAttributes": ["next_departure_at", "booking_status", "required_actions", "preferred_language"],
      "requiredAssets": ["authoritative_trip_information", "secure_manage_booking_link", "accessible_content"],
      "requiredPolicies": ["service_purpose_definition", "minimum_necessary_data", "minor_and_companion_data_rules", "time_zone_delivery", "cancellation_suppression"],
      "defaultJourney": ["booking_confirmed", "departure_minus_14d", "action_check", "departure_minus_3d", "final_service_update", "stop_on_cancellation"],
      "measurement": ["required action completion", "support deflection", "delivery success", "service complaint rate"],
      "stopConditions": ["booking cancelled", "trip completed", "contact invalid", "authoritative source unavailable"],
      "activationBlockers": ["unverified_booking_source", "unclear_service_purpose", "missing_secure_link", "missing_locale_or_timezone"]
    },
    {
      "id": "travel-05-ancillary-cross-sell", "name": "Relevant ancillary and upgrade offers", "industry": "travel", "tier": "booking_inventory_marketing",
      "businessObjective": "Offer relevant extras or upgrades without conflicting with the booked product or required service information.",
      "kpis": ["ancillary_attach_rate", "incremental_margin", "complaint_rate"], "channels": ["email", "web_banner", "push"],
      "requiredEvents": ["booking_confirmed", "ancillary_viewed", "ancillary_purchased", "booking_changed", "booking_cancelled"],
      "requiredEventFields": ["booking_id", "product_components", "travel_dates", "eligible_ancillary_id", "price", "currency"],
      "requiredIdentifiers": ["booking_id", "profile_id"],
      "requiredAttributes": ["owned_ancillaries", "eligible_ancillaries", "booking_status", "marketing_consent"],
      "requiredAssets": ["ancillary_catalog", "eligibility_rules", "margin_and_terms", "fallback_content"],
      "requiredPolicies": ["owned_item_exclusion", "eligibility_and_supplier_rules", "marketing_consent", "refund_change_suppression", "service_marketing_separation"],
      "defaultJourney": ["booking_confirmed", "eligibility_check", "offer_window", "purchase_split", "single_reminder", "stop_before_departure"],
      "measurement": ["booking-level holdout", "incremental margin", "refund and complaint rate"],
      "stopConditions": ["ancillary purchased", "booking changed", "booking cancelled", "departure window closed", "consent withdrawn"],
      "activationBlockers": ["missing_eligibility_rules", "missing_ancillary_catalog", "unverified_margin", "unverified_marketing_consent"]
    },
    {
      "id": "travel-06-disruption-communication", "name": "Disruption and recovery communication", "industry": "travel", "tier": "real_time_service",
      "businessObjective": "Deliver authoritative, timely service updates and recovery options for affected bookings.",
      "kpis": ["delivery_latency", "customer_acknowledgement", "self_service_rebooking", "support_load"], "channels": ["sms", "push", "email"],
      "requiredEvents": ["service_disruption_detected", "booking_affected", "recovery_option_available", "customer_acknowledged", "disruption_resolved"],
      "requiredEventFields": ["incident_id", "booking_id", "severity", "effective_at", "authoritative_message_version", "locale"],
      "requiredIdentifiers": ["booking_id", "verified_customer_contact"],
      "requiredAttributes": ["active_disruption", "affected_booking", "preferred_language", "accessibility_need_reference"],
      "requiredAssets": ["approved_incident_templates", "authoritative_status_source", "secure_recovery_link"],
      "requiredPolicies": ["service_only_purpose", "incident_owner_approval", "message_versioning", "accessibility", "no_marketing_content"],
      "defaultJourney": ["booking_affected", "severity_route", "send_service_update", "acknowledgement_split", "send_material_change", "close_on_resolution"],
      "measurement": ["delivery latency", "acknowledgement", "support deflection", "incorrect-message rate"],
      "stopConditions": ["incident resolved", "booking no longer affected", "authoritative source conflict", "manual incident stop"],
      "activationBlockers": ["no_authoritative_incident_source", "missing_booking_impact_mapping", "unapproved_templates", "unverified_contact"]
    },
    {
      "id": "travel-07-posttrip-feedback", "name": "Post-trip feedback and review", "industry": "travel", "tier": "trip_completion_identity",
      "businessObjective": "Collect service feedback after confirmed trip completion while suppressing disrupted or open-case customers when appropriate.",
      "kpis": ["response_rate", "service_recovery_rate", "review_completion", "complaint_rate"], "channels": ["email", "sms"],
      "requiredEvents": ["trip_completed", "support_case_opened", "feedback_submitted", "review_submitted"],
      "requiredEventFields": ["booking_id", "trip_completed_at", "supplier_ids", "case_status", "survey_id"],
      "requiredIdentifiers": ["booking_id", "profile_id"],
      "requiredAttributes": ["last_trip_completed_at", "open_service_case", "feedback_status", "channel_consent"],
      "requiredAssets": ["approved_survey", "review_link", "service_recovery_route"],
      "requiredPolicies": ["confirmed_completion_only", "open_case_suppression", "survey_frequency_cap", "review_incentive_terms", "channel_consent"],
      "defaultJourney": ["trip_completed", "delay_2d", "open_case_split", "survey", "feedback_route", "stop_on_submission"],
      "measurement": ["survey completion", "case recovery", "review completion", "unsubscribe rate"],
      "stopConditions": ["feedback submitted", "review submitted", "open complaint requires suppression", "consent withdrawn"],
      "activationBlockers": ["unverified_trip_completion", "missing_case_status", "unapproved_survey_or_terms", "unverified_consent"]
    },
    {
      "id": "travel-08-loyalty-winback", "name": "Loyalty and lapsed-traveler re-engagement", "industry": "travel", "tier": "dwh_identity_marketing",
      "businessObjective": "Re-engage customers using governed recency and preference signals without sensitive-destination or inferred-trait targeting.",
      "kpis": ["incremental_booking_rate", "repeat_booking_rate", "incremental_margin", "unsubscribe_rate"], "channels": ["email", "push", "paid_audience"],
      "requiredEvents": ["booking_confirmed", "trip_completed", "campaign_engagement"],
      "requiredEventFields": ["profile_id", "booking_at", "trip_completed_at", "destination_category", "booking_value", "currency"],
      "requiredIdentifiers": ["profile_id", "approved_paid_platform_identifier"],
      "requiredAttributes": ["days_since_last_booking", "booking_count", "destination_preferences", "channel_consent"],
      "requiredAssets": ["current_offer_feed", "destination_content", "suppression_export"],
      "requiredPolicies": ["lapse_definition_owner", "sensitive_destination_review", "channel_consent", "paid_export_approval", "frequency_cap"],
      "defaultJourney": ["enter_lapsed_segment", "email_inspiration", "engagement_split", "optional_push", "optional_paid_suppression", "stop_on_booking"],
      "measurement": ["customer-level holdout", "incremental confirmed bookings", "incremental margin", "channel complaints"],
      "stopConditions": ["booking confirmed", "consent withdrawn", "active service case", "paid export approval absent"],
      "activationBlockers": ["missing_booking_history", "unapproved_lapse_definition", "unverified_consent", "unapproved_paid_export"]
    }
  ]
